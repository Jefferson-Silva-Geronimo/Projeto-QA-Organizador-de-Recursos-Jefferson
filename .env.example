# Copie para .env e preencha com valores LOCAIS. O arquivo .env não é versionado.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Usados pela aplicação (application.yml)
DB_URL=jdbc:postgresql://localhost:5432/<POSTGRES_DB>
DB_USER=
DB_PASSWORD=

# Só para a análise do SonarCloud (CI usa variáveis do repositório)
SONAR_ORGANIZATION=
SONAR_PROJECT_KEY=
