# Copie para .env e preencha com valores LOCAIS. O arquivo .env não é versionado.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Usados pela aplicação (application.yml)
DB_URL=jdbc:postgresql://localhost:5432/<POSTGRES_DB>
DB_USER=
DB_PASSWORD=

# Duração da sessão em ISO-8601 (por exemplo PT30M). Obrigatória: o valor é a lacuna D17.
SESSAO_DURACAO=

# Primeiro Administrador (só cria se não houver usuário)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_SENHA=

# Só para a análise do SonarCloud (CI usa variáveis do repositório)
SONAR_ORGANIZATION=
SONAR_PROJECT_KEY=

# Front end (Fase 6): origem permitida pelo CORS, por exemplo a do Vite em desenvolvimento (http://localhost:5173).
# Vazio = nenhuma origem permitida. Nunca use curinga.
CORS_ORIGENS=

# Limite de tentativas de login por conta (SEC-01). Obrigatórios e sem valor padrão: a aplicação não sobe sem eles.
# LOGIN_TENTATIVAS é um inteiro (por exemplo, 5) e LOGIN_JANELA, uma duração ISO-8601 (por exemplo, PT10M).
# Valores decididos pela equipe em 17/10/2026 (P5-10): 5 tentativas em 10 minutos. O código não tem valor padrão.
LOGIN_TENTATIVAS=5
LOGIN_JANELA=PT10M
